<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/menuHeaderBar"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_header_bar"
    android:orientation="horizontal"
    android:padding="6dp"
    android:weightSum="3">

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnFishBox"
        android:layout_width="0dp"
        android:layout_height="48dp"
        android:layout_marginEnd="4dp"
        android:layout_weight="1"
        android:backgroundTint="#6C4527"
        android:ellipsize="end"
        android:insetTop="0dp"
        android:insetBottom="0dp"
        android:maxLines="1"
        android:paddingHorizontal="6dp"
        android:text="Fish Box"
        android:textAllCaps="false"
        android:textColor="@color/parchment"
        android:textSize="11sp"
        android:textStyle="bold"
        app:cornerRadius="10dp"
        app:icon="@drawable/ic_fish_box"
        app:iconGravity="textStart"
        app:iconPadding="4dp"
        app:iconSize="18dp"
        app:iconTint="@null"
        app:strokeColor="#C89B6E"
        app:strokeWidth="1dp" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnAlmanac"
        android:layout_width="0dp"
        android:layout_height="48dp"
        android:layout_marginHorizontal="2dp"
        android:layout_weight="1"
        android:backgroundTint="#6C4527"
        android:ellipsize="end"
        android:insetTop="0dp"
        android:insetBottom="0dp"
        android:maxLines="1"
        android:paddingHorizontal="6dp"
        android:text="Almanac"
        android:textAllCaps="false"
        android:textColor="@color/parchment"
        android:textSize="11sp"
        android:textStyle="bold"
        app:cornerRadius="10dp"
        app:icon="@drawable/ic_almanac"
        app:iconGravity="textStart"
        app:iconPadding="4dp"
        app:iconSize="18dp"
        app:iconTint="@null"
        app:strokeColor="#C89B6E"
        app:strokeWidth="1dp" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnEquipment"
        android:layout_width="0dp"
        android:layout_height="48dp"
        android:layout_marginStart="4dp"
        android:layout_weight="1"
        android:backgroundTint="#6C4527"
        android:ellipsize="end"
        android:insetTop="0dp"
        android:insetBottom="0dp"
        android:maxLines="1"
        android:paddingHorizontal="6dp"
        android:text="Inventory"
        android:textAllCaps="false"
        android:textColor="@color/parchment"
        android:textSize="11sp"
        android:textStyle="bold"
        app:cornerRadius="10dp"
        app:icon="@drawable/ic_rod"
        app:iconGravity="textStart"
        app:iconPadding="4dp"
        app:iconSize="18dp"
        app:iconTint="@null"
        app:strokeColor="#C89B6E"
        app:strokeWidth="1dp" />
</LinearLayout>
