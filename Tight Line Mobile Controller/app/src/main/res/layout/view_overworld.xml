<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_screen_water"
    android:fitsSystemWindows="true"
    android:padding="16dp">

    <include
        android:id="@+id/menuHeaderBar"
        layout="@layout/include_menu_header"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentTop="true"
        android:layout_marginTop="8dp" />

    <TextView
        android:id="@+id/modeTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_below="@id/menuHeaderBar"
        android:layout_centerHorizontal="true"
        android:layout_marginTop="18dp"
        android:background="@drawable/bg_pill_badge"
        android:paddingHorizontal="20dp"
        android:paddingVertical="7dp"
        android:text="OVERWORLD"
        android:textColor="@color/gold_highlight"
        android:textSize="14sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/playerIdentityBadge"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_below="@id/modeTitle"
        android:layout_centerHorizontal="true"
        android:layout_marginTop="8dp"
        android:background="@drawable/bg_pill_badge"
        android:paddingHorizontal="16dp"
        android:paddingVertical="5dp"
        android:text=""
        android:textColor="@color/text_light"
        android:textSize="13sp"
        android:textStyle="bold"
        android:visibility="gone" />

    <com.example.myapplication.DPadView
        android:id="@+id/dpadView"
        android:layout_width="260dp"
        android:layout_height="260dp"
        android:layout_centerInParent="true" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnInteract"
        android:layout_width="200dp"
        android:layout_height="60dp"
        android:layout_alignParentBottom="true"
        android:layout_centerHorizontal="true"
        android:layout_marginBottom="16dp"
        android:backgroundTint="@color/coral_primary"
        android:insetTop="0dp"
        android:insetBottom="0dp"
        android:text="INTERACT"
        android:textAllCaps="false"
        android:textColor="@color/text_light"
        android:textSize="17sp"
        android:textStyle="bold"
        app:cornerRadius="16dp"
        app:strokeColor="@color/parchment"
        app:strokeWidth="2dp" />

</RelativeLayout>
