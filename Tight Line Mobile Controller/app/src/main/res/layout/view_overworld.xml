<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#121212"
    android:padding="16dp">

    <!-- Top Menu Header Bar -->
    <LinearLayout
        android:id="@+id/menuHeaderBar"
        android:layout_marginTop="80dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentTop="true"
        android:orientation="horizontal"
        android:weightSum="3">

        <Button
            android:id="@+id/btnFishBox"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:backgroundTint="#2E4057"
            android:text="🐟 Fish Box"
            android:textColor="#FFFFFF"
            android:textSize="12sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btnAlmanac"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:backgroundTint="#048A81"
            android:text="📖 Almanac"
            android:textColor="#FFFFFF"
            android:textSize="12sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btnEquipment"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:backgroundTint="#545B77"
            android:text="🎣 Equipment"
            android:textColor="#FFFFFF"
            android:textSize="12sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- D-Pad View -->

    <!-- Interact Action Button -->

    <TextView
        android:id="@+id/modeTitle"
        android:layout_width="340dp"
        android:layout_height="40dp"
        android:layout_below="@id/menuHeaderBar"
        android:layout_alignParentEnd="true"
        android:layout_marginTop="62dp"
        android:layout_marginEnd="8dp"
        android:text="[ Overworld Controller ]"
        android:textAlignment="center"
        android:textColor="#00FF66"
        android:textSize="16sp"
        android:textStyle="bold" />

    <com.example.myapplication.DPadView
        android:id="@+id/dpadView"
        android:layout_width="249dp"
        android:layout_height="266dp"
        android:layout_above="@+id/btnInteract"
        android:layout_alignParentStart="true"
        android:layout_alignParentEnd="true"
        android:layout_marginStart="108dp"
        android:layout_marginEnd="101dp"
        android:layout_marginBottom="98dp" />

    <Button
        android:id="@+id/btnInteract"
        android:layout_width="160dp"
        android:layout_height="60dp"
        android:layout_alignParentBottom="true"
        android:layout_centerHorizontal="true"
        android:layout_marginBottom="16dp"
        android:backgroundTint="#F4A261"
        android:text="INTERACT (E)"
        android:textColor="#121212"
        android:textSize="16sp"
        android:textStyle="bold" />

</RelativeLayout>