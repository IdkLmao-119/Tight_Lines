<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#121212"
    android:fitsSystemWindows="true"
    android:padding="16dp">

    <include
        android:id="@+id/menuHeaderBar"
        layout="@layout/include_menu_header"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentTop="true"
        android:layout_marginTop="12dp" />

    <TextView
        android:id="@+id/modeTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_below="@id/menuHeaderBar"
        android:layout_centerHorizontal="true"
        android:layout_marginTop="24dp"
        android:text="[ Overworld Controller ]"
        android:textAlignment="center"
        android:textColor="#00FF66"
        android:textSize="16sp"
        android:textStyle="bold" />

    <com.example.myapplication.DPadView
        android:id="@+id/dpadView"
        android:layout_width="250dp"
        android:layout_height="250dp"
        android:layout_centerInParent="true" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnInteract"
        android:layout_width="180dp"
        android:layout_height="58dp"
        android:layout_alignParentBottom="true"
        android:layout_centerHorizontal="true"
        android:layout_marginBottom="16dp"
        android:backgroundTint="#F4A261"
        android:insetTop="0dp"
        android:insetBottom="0dp"
        android:text="INTERACT (E)"
        android:textColor="#121212"
        android:textSize="16sp"
        android:textStyle="bold"
        app:cornerRadius="14dp" />

</RelativeLayout>
