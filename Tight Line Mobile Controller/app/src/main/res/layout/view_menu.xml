<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0F172A"
    android:fitsSystemWindows="true"
    android:padding="16dp">

    <include
        android:id="@+id/menuHeaderBar"
        layout="@layout/include_menu_header"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentTop="true"
        android:layout_marginTop="12dp" />

    <TextView
        android:id="@+id/menuTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_below="@id/menuHeaderBar"
        android:layout_centerHorizontal="true"
        android:layout_marginTop="24dp"
        android:text="MENU"
        android:textColor="#64FFDA"
        android:textSize="22sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/menuHint"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@id/menuTitle"
        android:layout_marginTop="6dp"
        android:gravity="center"
        android:text="Use D-Pad to browse and Select to interact"
        android:textColor="#94A3B8"
        android:textSize="13sp" />

    <!-- Optional Tab / Section Switcher (used for Almanac Locations & Inventory Rods/Bait) -->
    <LinearLayout
        android:id="@+id/menuTabBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@id/menuHint"
        android:layout_marginTop="18dp"
        android:gravity="center"
        android:orientation="horizontal">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnTabPrev"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_marginEnd="8dp"
            android:layout_weight="1"
            android:backgroundTint="#1E293B"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:text="◀ Prev Area"
            android:textAllCaps="false"
            android:textColor="#E2E8F0"
            android:textSize="13sp"
            android:textStyle="bold"
            app:cornerRadius="10dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnTabNext"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:backgroundTint="#1E293B"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:text="Next Area ▶"
            android:textAllCaps="false"
            android:textColor="#E2E8F0"
            android:textSize="13sp"
            android:textStyle="bold"
            app:cornerRadius="10dp" />
    </LinearLayout>

    <!-- 4-Way Discrete D-Pad for Menu Navigation -->
    <RelativeLayout
        android:id="@+id/menuDpad"
        android:layout_width="240dp"
        android:layout_height="240dp"
        android:layout_centerInParent="true">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnNavUp"
            android:layout_width="76dp"
            android:layout_height="76dp"
            android:layout_alignParentTop="true"
            android:layout_centerHorizontal="true"
            android:backgroundTint="#1E293B"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:text="▲"
            android:textColor="#F8FAFC"
            android:textSize="22sp"
            app:cornerRadius="18dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnNavDown"
            android:layout_width="76dp"
            android:layout_height="76dp"
            android:layout_alignParentBottom="true"
            android:layout_centerHorizontal="true"
            android:backgroundTint="#1E293B"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:text="▼"
            android:textColor="#F8FAFC"
            android:textSize="22sp"
            app:cornerRadius="18dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnNavLeft"
            android:layout_width="76dp"
            android:layout_height="76dp"
            android:layout_alignParentStart="true"
            android:layout_centerVertical="true"
            android:backgroundTint="#1E293B"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:text="◀"
            android:textColor="#F8FAFC"
            android:textSize="22sp"
            app:cornerRadius="18dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnNavRight"
            android:layout_width="76dp"
            android:layout_height="76dp"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true"
            android:backgroundTint="#1E293B"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:text="▶"
            android:textColor="#F8FAFC"
            android:textSize="22sp"
            app:cornerRadius="18dp" />
    </RelativeLayout>

    <!-- Bottom Action Buttons -->
    <LinearLayout
        android:id="@+id/menuActionBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:layout_marginBottom="16dp"
        android:orientation="horizontal"
        android:weightSum="2">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnMenuBack"
            android:layout_width="0dp"
            android:layout_height="58dp"
            android:layout_marginEnd="8dp"
            android:layout_weight="1"
            android:backgroundTint="#E76F51"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:text="✕ CLOSE"
            android:textColor="#FFFFFF"
            android:textSize="16sp"
            android:textStyle="bold"
            app:cornerRadius="14dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnMenuSelect"
            android:layout_width="0dp"
            android:layout_height="58dp"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:backgroundTint="#2A9D8F"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:text="✓ SELECT"
            android:textColor="#FFFFFF"
            android:textSize="16sp"
            android:textStyle="bold"
            app:cornerRadius="14dp" />
    </LinearLayout>

</RelativeLayout>
