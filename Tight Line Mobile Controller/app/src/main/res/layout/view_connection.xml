<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_screen_water"
    android:fillViewport="true"
    android:fitsSystemWindows="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="20dp">

        <!-- Title Banner -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="20dp"
            android:background="@drawable/bg_title_panel"
            android:gravity="center"
            android:orientation="vertical"
            android:paddingHorizontal="20dp"
            android:paddingVertical="18dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:shadowColor="#FFF3DC"
                android:shadowDx="0"
                android:shadowDy="1"
                android:shadowRadius="2"
                android:text="TIGHT LINES"
                android:textColor="@color/text_dark"
                android:textSize="28sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="Mobile Fishing Controller"
                android:textColor="#5C381E"
                android:textSize="13sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Wooden Connection Card -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_wood_card"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:padding="22dp">

            <ImageView
                android:layout_width="52dp"
                android:layout_height="52dp"
                android:layout_marginBottom="10dp"
                android:contentDescription="Fishing Rod"
                android:src="@drawable/ic_rod" />

            <ProgressBar
                android:id="@+id/connectingSpinner"
                style="?android:attr/progressBarStyle"
                android:layout_width="34dp"
                android:layout_height="34dp"
                android:layout_marginBottom="10dp"
                android:indeterminateTint="@color/gold_highlight" />

            <TextView
                android:id="@+id/statusText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:text="Searching for Tight Lines PC..."
                android:textColor="@color/text_light"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/connectionSubtext"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:gravity="center"
                android:text="Auto-connecting on the same Wi-Fi or Hotspot"
                android:textColor="@color/text_muted"
                android:textSize="12sp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:layout_marginBottom="4dp"
                android:text="Angler Name (Multiplayer)"
                android:textColor="@color/parchment"
                android:textSize="12sp"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/playerNameInput"
                android:layout_width="match_parent"
                android:layout_height="46dp"
                android:background="@drawable/bg_input_field"
                android:hint="Enter your name (optional)"
                android:inputType="textPersonName"
                android:maxLength="18"
                android:paddingHorizontal="14dp"
                android:singleLine="true"
                android:textColor="@color/text_dark"
                android:textColorHint="#8C6B50"
                android:textSize="14sp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/discoverButton"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:layout_marginTop="14dp"
                android:backgroundTint="@color/coral_primary"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:text="Scan Again"
                android:textAllCaps="false"
                android:textColor="@color/text_light"
                android:textSize="15sp"
                android:textStyle="bold"
                app:cornerRadius="12dp"
                app:strokeColor="@color/parchment"
                app:strokeWidth="2dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnToggleManual"
                style="@style/Widget.TightLines.TextButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Manual IP Setup ▾"
                android:textAllCaps="false"
                android:textColor="@color/gold_highlight"
                android:textSize="13sp"
                android:textStyle="bold" />

            <!-- Collapsible Manual IP Entry -->
            <LinearLayout
                android:id="@+id/manualConnectSection"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:orientation="vertical"
                android:visibility="gone">

                <EditText
                    android:id="@+id/serverIpInput"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:background="@drawable/bg_input_field"
                    android:hint="PC IP (e.g. 192.168.137.1)"
                    android:inputType="text"
                    android:paddingHorizontal="14dp"
                    android:singleLine="true"
                    android:textColor="@color/text_dark"
                    android:textColorHint="#8C6B50"
                    android:textSize="14sp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/connectButton"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:layout_marginTop="10dp"
                    android:backgroundTint="@color/teal_accent"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:text="Connect Manually"
                    android:textAllCaps="false"
                    android:textColor="@color/text_light"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    app:cornerRadius="12dp"
                    app:strokeColor="@color/parchment"
                    app:strokeWidth="2dp" />
            </LinearLayout>
        </LinearLayout>

    </LinearLayout>
</ScrollView>
