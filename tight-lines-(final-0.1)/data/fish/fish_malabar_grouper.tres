scientific_name = "Epinephelus malabaricus"
description = "A large, heavy-bodied reef and estuarine predator native to the Indo-West Pacific, inhabiting coral and rocky reefs, tide pools, estuaries, and mangrove swamps. It has a brownish body covered in small dark spots and pale blotches, feeding on fishes, crustaceans, and cephalopods."
